{
  "name": "nuntia",
  "version": "0.1.0",
  "description": "Generate AI-authored release notes and migration guides from a commit range.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run typecheck && rimraf dist && ncc build src/index.ts -o dist --minify --source-map --license licenses.txt",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.cjs",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:dist"
  },
  "keywords": [
    "github-actions",
    "release-notes",
    "changelog",
    "migration-guide",
    "ai"
  ],
  "author": "Daniel Chalmers",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "action.yml",
    "README.md",
    "dist/"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vercel/ncc": "^0.44.1",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@google/genai": "^2.10.0"
  }
}
