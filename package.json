{
  "name": "nuntia",
  "version": "0.1.0",
  "description": "Generate AI-authored release notes and migration guides from a commit range.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run typecheck && npm run clean && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --legal-comments=eof --outfile=dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.cjs",
    "dev": "tsc --noEmit -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:dist"
  },
  "keywords": [
    "github-actions",
    "release-notes",
    "changelog",
    "migration-guide",
    "ai"
  ],
  "author": "Daniel Chalmers",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "action.yml",
    "README.md",
    "dist/"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@google/genai": "^2.17.1",
    "@octokit/plugin-throttling": "^11.0.3"
  }
}
